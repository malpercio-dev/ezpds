meta {
  name: Space Get Repo
  type: http
  seq: 156
}

get {
  url: {{baseUrl}}/xrpc/com.atproto.space.getRepo?space=at:space/did:plc:authorityaaaaaaaaaaaaaaa/org.example.bucket/main&repo={{did}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  space: at:space/did:plc:authorityaaaaaaaaaaaaaaa/org.example.bucket/main
  repo: {{did}}
}

docs {
  Download a space repo as an "atproto-space-repo" STAR archive
  (application/vnd.dasl.star). The metadata is the commit { ver, repo, space, rev, data }, then
  one "{collection}/{rkey}" → record pair per record, in strict bytewise key order. A syncer
  folds each path and record CID into a set hash and compares it with the commit's data. The
  MAC over the commit rides the response headers (Accept-Signature), not the body. Blobs are
  not included (fetch via space.getBlob).

  The archive is what com.atproto.space.importRepo takes on the destination host.
}
