meta {
  name: Simplespace Create Space
  type: http
  seq: 148
}

post {
  url: {{baseUrl}}/xrpc/com.atproto.simplespace.createSpace
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "type": "org.example.bucket",
    "skey": "main",
    "policy": { "$type": "com.atproto.simplespace.defs#memberListPolicy" },
    "appAccess": { "$type": "com.atproto.simplespace.defs#open" }
  }
}

docs {
  Atproto Spaces (simplespace): create a space anchored on the authenticated account's own
  DID. The URI is at://{callerDid}/space/{type}/{skey}; "skey" is optional (a TID is
  generated when absent) and uses record-key syntax.

  "policy" and "appAccess" are open unions and both are required. This host implements
  the "#publicPolicy" and "#memberListPolicy" policies and "#open" app access; anything
  else — "#managingAppPolicy", "#allowList", or an unknown $type — is refused with 400
  UnsupportedPolicy / UnsupportedAppAccess and never stored.

  Responds { uri }. Errors: 400 SpaceAlreadyExists when an active space already holds the
  URI (a deleted one may be created again), 403 InsufficientScope when the OAuth grant
  carries no "space:…?manage=create" covering the space.
}
