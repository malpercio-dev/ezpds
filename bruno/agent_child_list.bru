meta {
  name: List Sovereign Child Agents
  type: http
  seq: 108
}

get {
  url: {{baseUrl}}/agent/child
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

docs {
  Lists sovereign child identities provisioned by the authenticated local parent account.

  Each entry carries `registrationId`, `did`, `handle`, `status`, `createdAt`, the child's
  granted `scopes`, and `effectiveScopes` (the grant clamped to the current scope profile; a scope
  in `scopes` but not `effectiveScopes` is suspended). A child whose deletion has been scheduled also carries `deleteAfter`, the
  instant the reaper purges it — deleting a child revokes it as a side effect, so `status` alone
  cannot distinguish a retired child from a merely revoked one.
}
