meta {
  name: OAuth Token — Refresh Token Rotation
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/oauth/token
  body: formUrlEncoded
  auth: none
}

headers {
  DPoP: {{dpopProof}}
}

body:form-urlencoded {
  grant_type: refresh_token
  refresh_token: {{refreshToken}}
  client_id: https://app.example.com/client-metadata.json
}

vars:pre-request {
  dpopProof: <replace-with-dpop-proof-jwt>
  refreshToken: <replace-with-refresh-token>
}

docs {
  The DPoP header is required unless the grant was issued for one of the operator's
  `[oauth] connector_resources`. A connector grant may omit it and then gets an unbound token:
  `token_type` is `Bearer`, `expires_in` is 300, and the access token's `aud` is the connector
  resource. An optional `resource` form field must name the target the grant was issued for,
  or the request is `invalid_target`.
}
