meta {
  name: Delete Sovereign Child Agent (POST /v1/agents/:registration_id/delete)
  type: http
  seq: 123
}

post {
  url: {{baseUrl}}/v1/agents/{{registrationId}}/delete
  body: none
  auth: bearer
}

auth:bearer {
  token: {{sessionToken}}
}

docs {
  Parent-authed permanent deletion of a sovereign child agent. Implies revoke, then
  deactivates the child and schedules it for purge after `accounts.child_deletion_grace_secs`
  (the reaper emits `#account status="deleted"` and removes all local hosting). An unknown,
  foreign, or non-child registration id returns a uniform 404, and
  agent-derived credentials are refused by the owner guard. The wallet-held recovery key and the
  did:plc identity are untouched — a full identity retirement is delete-on-PDS plus a
  wallet-driven PLC tombstone.

  Response: { "did", "status": "deletion_scheduled", "deleteAfter": "<rfc3339>" }.
}
