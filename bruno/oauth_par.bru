meta {
  name: OAuth PAR — Push Authorization Request
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/oauth/par
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  client_id: https://app.example.com/client-metadata.json
  redirect_uri: https://app.example.com/callback
  code_challenge: {{codeChallenge}}
  code_challenge_method: S256
  state: {{state}}
  response_type: code
  scope: atproto
  ~resource: https://mcp.example.com
}

vars:pre-request {
  codeChallenge: <replace-with-base64url-sha256-of-code-verifier>
  state: <replace-with-random-state-value>
}

docs {
  `resource` (RFC 8707, optional) must name this server or one of the operator's
  `[oauth] connector_resources`; anything else is `invalid_target`. Naming a connector resource
  makes this a connector request: the grant is recorded as an MCP connector in the owner's
  My agents and its tokens are issued on the connector terms. Every other grant is recorded as
  an `oauth_app`.
}
