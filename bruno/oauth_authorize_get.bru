meta {
  name: OAuth Authorize — GET (Consent Page)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/oauth/authorize?client_id={{clientId}}&request_uri={{requestUri}}
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:8080
  clientId: https://app.example.com/client-metadata.json
  requestUri: urn:ietf:params:oauth:request_uri:REPLACE_WITH_PAR_RESPONSE
}

docs {
  PAR-only: push the authorization parameters to POST /oauth/par first and paste the
  returned request_uri here. A request with inline parameters (or a JAR `request`
  object) is refused with a 400 error page.

  The exception is an MCP connector: a request whose `resource` is one of the operator's
  `[oauth] connector_resources` may send its parameters inline instead
  (client_id, redirect_uri, response_type=code, code_challenge, code_challenge_method=S256,
  resource, and optionally state, scope, response_mode, login_hint).
}
